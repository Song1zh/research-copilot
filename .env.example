APP_ENV=development
APP_NAME=research-copilot

# OpenAI-compatible provider configuration.
# DashScope remains the retrieval provider when embedding/reranking is enabled.
DASHSCOPE_API_KEY=your_api_key_here
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_MODEL=qwen3.7-plus-2026-05-26
GROUNDEDNESS_MODEL=qwen3.7-plus-2026-05-26

# Optional chat-only provider override. CHAT_API_KEY can also be provided
# through OPENAI_API_KEY or MOONSHOT_API_KEY.
# CHAT_BASE_URL=https://api.moonshot.ai/v1
# CHAT_API_KEY=your_chat_api_key_here

# Embedding provider is explicit. "dashscope" never silently falls back.
EMBEDDING_PROVIDER=local_hash
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSIONS=1024
EMBEDDING_BATCH_SIZE=10
LOCAL_HASH_DIMENSIONS=64

# Reranker is explicit. DashScope errors are surfaced and never fall back.
RERANKER_PROVIDER=dashscope
RERANK_MODEL=qwen3-rerank
# Replace with the compatible-api URL shown for your Model Studio workspace.
DASHSCOPE_RERANK_BASE_URL=https://YOUR_WORKSPACE_ID.cn-beijing.maas.aliyuncs.com/compatible-api/v1
RERANK_CANDIDATE_K=30
RERANK_TIMEOUT_SECONDS=30
RERANK_MAX_DOCUMENTS=500
RERANK_MAX_DOCUMENT_CHARS=8000

# Knowledge graph is explicit for reproducible on/off A/B evaluation.
KG_PROVIDER=neo4j
